{
  "name": "crypto-scanner-gui",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/main.js",
  "scripts": {
    "build-renderer": "webpack --mode=production",
    "build-main": "tsc --project tsconfig.main.json",
    "build-preload": "tsc --project tsconfig.preload.json",
    "build": "npm run build-renderer && npm run build-main && npm run build-preload",
    "dev-renderer": "webpack serve --mode=development",
    "dev-main": "electron dist/main/main.js",
    "dev": "npm run build && npm run dev-main",
    "start": "npm run dev",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && npm run dist:linux-amd && npm run dist:linux-arm",
    "dist:linux-amd": "npm run build && npm run copy-backend && electron-builder --linux --x64 --dir && mv ../linux-unpacked ../linux-amd",
    "dist:linux-arm": "npm run build && npm run copy-backend && electron-builder --linux --arm64 --dir && mv ../linux-arm64-unpacked ../linux-arm",
    "dist:win": "npm run build && npm run dist:win-amd && npm run dist:win-arm",
    "dist:win-amd": "npm run build && npm run copy-backend && electron-builder --win --x64 --dir && move ..\\win-unpacked ..\\win-amd",
    "dist:win-arm": "npm run build && npm run copy-backend && electron-builder --win --arm64 --dir && move ..\\win-arm64-unpacked ..\\win-arm",
    "copy-backend": "node ./scripts/copy-backend.js",
    "rebuild": "npm run pack",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postbuild": "npm run copy-backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.2",
    "docx": "^9.5.1",
    "docxtemplater": "^3.67.4",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.5",
    "pizzip": "^3.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "sudo-prompt": "^9.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.8.29",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.2",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.4",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.13",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "build": {
    "appId": "com.cryptoscanner.app",
    "productName": "CryptoScanner",
    "asar": false,
    "directories": {
      "output": "../"
    },
    "files": [
      "dist/**/*",
      "!dist/main/result/**/*",
      "src/renderer/assets/**/*",
      "../.env"
    ],
    "asarUnpack": [
      "dist/main/CryptoScanner",
      "dist/main/CryptoScannerCLI",
      "dist/main/CryptoScannerCLI.exe",
      "dist/main/CryptoScanner.exe",
      "dist/main/Qt5Core.dll",
      "dist/main/libgcc_s_seh-1.dll",
      "dist/main/libstdc++-6.dll",
      "dist/main/libwinpthread-1.dll",
      "dist/main/libatomic-1.dll",
      "dist/main/libcrypto-3-x64.dll",
      "dist/main/libssl-3-x64.dll",
      "dist/main/patterns.json",
      "dist/main/*.dll",
      "dist/main/dynamic_analysis_cli",
      "dist/main/dynamic_analysis_cli.exe",
      "dist/main/libhook.so",
      "dist/main/libhook.dylib",
      "dist/main/hook.dll",
      "dist/main/.env",
      ".env"
    ],
    "mac": {
      "icon": "src/renderer/assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    },
    "win": {
      "icon": "src/renderer/assets/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "src/renderer/assets/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
